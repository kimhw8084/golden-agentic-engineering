{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Golden capability selection registry",
  "type": "object",
  "required": [
    "schema",
    "task_decisions",
    "workflow_routes_covered",
    "non_public_capability_ids",
    "candidates",
    "required_before_import"
  ],
  "properties": {
    "schema": { "const": "golden-capability-selection/v1" },
    "task_decisions": { "type": "array", "minItems": 12 },
    "workflow_routes_covered": { "type": "array", "minItems": 12, "uniqueItems": true, "items": { "type": "string" } },
    "non_public_capability_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "capability_type", "owner_repo", "commit", "version", "purpose",
          "license", "license_evidence", "license_url", "transitive_dependencies",
          "models_browsers", "windows_linux", "offline_telemetry", "context_cost",
          "maintenance", "permissions", "prompt_injection_security", "measured_evidence",
          "decision"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "capability_type": {
            "type": "string",
            "enum": [
              "agent_skill",
              "opencode_plugin",
              "agent_workflow",
              "agent_framework",
              "browser_tool",
              "mcp_server",
              "mcp_sdk",
              "mcp_reference_server",
              "mcp_inspector",
              "evaluation_system",
              "application_framework",
              "validation_library",
              "analytics_engine",
              "deterministic_cli"
            ]
          },
          "owner_repo": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
          "version": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "license_evidence": { "type": "string", "minLength": 1 },
          "license_url": { "type": "string", "minLength": 1 },
          "transitive_dependencies": { "type": "string", "minLength": 1 },
          "models_browsers": { "type": "string", "minLength": 1 },
          "windows_linux": { "type": "string", "minLength": 1 },
          "offline_telemetry": { "type": "string", "minLength": 1 },
          "context_cost": { "type": "string", "minLength": 1 },
          "maintenance": { "type": "string", "minLength": 1 },
          "permissions": { "type": "string", "minLength": 1 },
          "prompt_injection_security": { "type": "string", "minLength": 1 },
          "measured_evidence": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "not_selected_for_vendor": { "type": "array", "items": { "type": "string" } },
    "required_before_import": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": true
}
